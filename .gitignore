# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
.turbo

# production
/build

# misc
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Secrets. This repo is public — everything below is a hard rule, not a
# preference. If you need to add a file that looks like a credential, don't.
# ---------------------------------------------------------------------------
# Every env file...
.env*
# ...except the template, or nobody knows what to fill in.
!.env.example

# Keys, certificates and credential dumps of any shape.
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
*.asc
*.gpg
id_rsa*
id_ed25519*
secrets.json
credentials.json
service-account*.json
gha-creds-*.json

# Cloud CLI state
.vercel
.netlify
.firebase
.aws
.gcloud

# debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors — can hold local paths, tokens and per-machine config
.vscode/*
!.vscode/extensions.json
.idea
*.swp
*.swo

# typescript
*.tsbuildinfo
next-env.d.ts
