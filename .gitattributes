# Normalise line endings in the repo to LF, regardless of the machine.
# Without this, a Windows checkout commits CRLF and every file shows as fully
# rewritten the first time anyone touches it from macOS or Linux.
* text=auto eol=lf

# Keep these byte-for-byte.
*.woff2 binary
*.woff  binary
*.ttf   binary
*.otf   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.docx  binary

# Generated — collapse in diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
lib/supabase/database.types.ts linguist-generated=true
