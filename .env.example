# Copy to .env.local and fill in. lib/env.ts validates these at startup and
# fails with a list of what is missing, so a blank value here is not silent.

# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Bypasses Row Level Security. Server-side only, never in a client component,
# never committed. If this leaks, rotate it immediately — it can read and write
# every user's data.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Google Gemini — https://aistudio.google.com/apikey
# Used for text parsing and receipt extraction. Models are pinned in
# lib/ai/, not here.
#
# NOTE: on the free tier Google may use submitted content to improve its
# products. That is fine for development, but receipts carry merchant names and
# amounts — move to a paid key before real users enter real data.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Groq — https://console.groq.com/keys
# Speech-to-text (whisper-large-v3) for the voice entry method.
# ---------------------------------------------------------------------------
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used for OAuth redirect URLs. http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL=http://localhost:3000
